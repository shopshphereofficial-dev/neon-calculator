<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:letterSpacing="0.12"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"
        android:shadowColor="#FF2EE6FF"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="14"
        android:text="@string/app_title"
        android:textColor="#2EE6FF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_display"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/tvExpression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:singleLine="true"
            android:textColor="#9FB4D8"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:shadowColor="#80FF2E9A"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="18"
            android:singleLine="true"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="46sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:shadowColor="#809BFF2E"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="10"
            android:singleLine="true"
            android:textColor="@color/neon_lime"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                style="@style/CalcButton.Clear"
                android:onClick="onClear"
                android:text="C" />

            <Button
                style="@style/CalcButton.Back"
                android:onClick="onBackspace"
                android:text="⌫" />

            <Button
                style="@style/CalcButton.Percent"
                android:onClick="onPercent"
                android:text="%" />

            <Button
                style="@style/CalcButton.Operator"
                android:onClick="onOperator"
                android:tag="/"
                android:text="÷" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                style="@style/CalcButton"
                android:onClick="onDigit"
                android:tag="7"
                android:text="7" />

            <Button
                style="@style/CalcButton"
                android:onClick="onDigit"
                android:tag="8"
                android:text="8" />

            <Button
                style="@style/CalcButton"
                android:onClick="onDigit"
                android:tag="9"
                android:text="9" />

            <Button
                style="@style/CalcButton.Operator"
                android:onClick="onOperator"
                android:tag="*"
                android:text="×" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                style="@style/CalcButton"
                android:onClick="onDigit"
                android:tag="4"
                android:text="4" />

            <Button
                style="@style/CalcButton"
                android:onClick="onDigit"
                android:tag="5"
                android:text="5" />

            <Button
                style="@style/CalcButton"
                android:onClick="onDigit"
                android:tag="6"
                android:text="6" />

            <Button
                style="@style/CalcButton.Operator"
                android:onClick="onOperator"
                android:tag="-"
                android:text="−" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                style="@style/CalcButton"
                android:onClick="onDigit"
                android:tag="1"
                android:text="1" />

            <Button
                style="@style/CalcButton"
                android:onClick="onDigit"
                android:tag="2"
                android:text="2" />

            <Button
                style="@style/CalcButton"
                android:onClick="onDigit"
                android:tag="3"
                android:text="3" />

            <Button
                style="@style/CalcButton.Operator"
                android:onClick="onOperator"
                android:tag="+"
                android:text="+" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                style="@style/CalcButton"
                android:layout_weight="2"
                android:onClick="onDigit"
                android:tag="0"
                android:text="0" />

            <Button
                style="@style/CalcButton"
                android:onClick="onDecimal"
                android:tag="."
                android:text="." />

            <Button
                style="@style/CalcButton.Equals"
                android:onClick="onEquals"
                android:text="=" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.gms.ads.AdView
        android:id="@+id/adView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:adSize="BANNER"
        app:adUnitId="ca-app-pub-7206645274499834/7211611841" />

</LinearLayout>
